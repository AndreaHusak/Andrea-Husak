---
import Legal from '../layouts/Legal.astro';
import { contact } from '../lib/site';
---

<Legal title="Impressum" description="Impressum der Husak-Ramesohl GmbH, Grafenau." path="impressum/">
  <h2>Angaben gemäß § 5 DDG</h2>
  <address>
    {contact.company}<br />
    {contact.street}<br />
    {contact.city}
  </address>
  <p>
    Handelsregister: HRB 794114<br />
    Registergericht: Amtsgericht Stuttgart
  </p>
  <p>Vertreten durch die Geschäftsführerin: {contact.name}</p>

  <h2>Kontakt</h2>
  <p>
    Telefon: <a href={contact.phoneHref}>{contact.phoneDisplay}</a><br />
    E-Mail: <a href={`mailto:${contact.email}`}>{contact.email}</a>
  </p>

  <h2>Umsatzsteuer-ID</h2>
  <p>Umsatzsteuer-Identifikationsnummer gemäß § 27a Umsatzsteuergesetz: {contact.vat}</p>

  <h2>Verantwortlich für den Inhalt</h2>
  <p>
    Lorem ipsum dolor sit amet, consectetur adipiscing elit. {contact.name}, Anschrift wie oben. Sed do eiusmod tempor
    incididunt ut labore et dolore magna aliqua.
  </p>


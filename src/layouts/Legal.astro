---
import Base from './Base.astro';
interface Props {
  title: string;
  description: string;
  path: string;
}
const { title, description, path } = Astro.props;
---

<Base title={`${title} – Andrea Husak-Ramesohl`} description={description} path={path}>
  <article class="legal wrap">
    <h1>{title}</h1>
    <p class="notice" role="note">
      Platzhaltertext: Dieser Inhalt ist ein Dummy und muss vor dem Livegang durch rechtlich geprüfte Texte ersetzt
      werden.
    </p>
    <slot />
  </article>
</Base>

<style>
  .legal {
    max-width: calc(46rem + 2 * var(--gutter));
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) var(--section);
  }
  h1 {
    font-size: var(--step-4);
    color: var(--forest);
    font-weight: 400;
  }
  .notice {
    margin: 1.8rem 0 2.8rem;
    padding: 1rem 1.2rem;
    border-radius: 10px;
    background: #fff7e0;
    border: 1px solid #f0dc9c;
    color: #6b5310;
    font-size: 0.95rem;
  }
  .legal :global(h2) {
    font-size: var(--step-2);
    color: var(--forest);
    margin: 2.6rem 0 0.8rem;
  }
  .legal :global(h3) {
    font-family: var(--sans);
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: 0;
    margin: 1.6rem 0 0.4rem;
  }
  .legal :global(p) {
    margin-bottom: 1rem;
  }
  .legal :global(address) {
    font-style: normal;
    margin-bottom: 1rem;
  }
</style>
